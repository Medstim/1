-- ============================================================
-- Services & Dependencies
-- ============================================================
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local VirtualUser      = game:GetService("VirtualUser")
local TeleportService  = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- Global Connections Storage
getgenv().InfiniteJumpConnection = nil
getgenv().NoclipConnection       = nil
getgenv().WalkSpeedConnection   = nil

-- ============================================================
-- Background Handlers
-- ============================================================

-- Anti-AFK Handler (Automatic)
LocalPlayer.Idled:Connect(function()
    if getgenv().AntiAFK ~= false then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end
end)

-- ============================================================
-- Global Functions
-- ============================================================

-- WalkSpeed Enforcer
getgenv().EnableWalkSpeed = function(speed)
    if getgenv().WalkSpeedConnection then
        getgenv().WalkSpeedConnection:Disconnect()
        getgenv().WalkSpeedConnection = nil
    end

    local function Attach(char)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        humanoid.WalkSpeed = speed
        getgenv().WalkSpeedConnection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if humanoid.WalkSpeed ~= speed then
                humanoid.WalkSpeed = speed
            end
        end)
    end

    if LocalPlayer.Character then task.spawn(Attach, LocalPlayer.Character) end
    LocalPlayer.CharacterAdded:Connect(Attach)
end

-- Infinite Jump Handler
getgenv().EnableInfiniteJump = function(enabled)
    if getgenv().InfiniteJumpConnection then
        getgenv().InfiniteJumpConnection:Disconnect()
        getgenv().InfiniteJumpConnection = nil
    end

    if enabled then
        getgenv().InfiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
            if LocalPlayer.Character then
                local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    end
end

-- Noclip Loop
getgenv().RunNoclip = function(enabled)
    if getgenv().NoclipConnection then
        getgenv().NoclipConnection:Disconnect()
        getgenv().NoclipConnection = nil
    end

    if enabled then
        getgenv().NoclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

-- Field of View Changer
getgenv().SetFOV = function(fovValue)
    workspace.CurrentCamera.FieldOfView = fovValue
end

-- 3D Rendering Toggle
getgenv().Set3dRendering = function(enabled)
    RunService:Set3dRenderingEnabled(enabled)
end

-- Rejoin Server Function
getgenv().RejoinServer = function()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end

-- Copy Job ID Function
getgenv().CopyJobID = function()
    if setclipboard then
        setclipboard(game.JobId)
    end
end

-- Copy Game ID Function
getgenv().CopyGameID = function()
    if setclipboard then
        setclipboard(game.GameId)
    end
end

-- Copy  Place ID Function
getgenv().CopyPlaceID = function()
    if setclipboard then
        setclipboard(game.PlaceId)
    end
end
